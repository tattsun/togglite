#pragma code_page(65001)
1 24 "togglite.manifest"
IDI_IDLE ICON "icons/idle.ico"
IDI_RUN ICON "icons/running.ico"

// VER_COMMA (e.g. 0,2,0,0) and VER_STR (e.g. "0.2.0") come from build.rs, from Cargo.toml.
1 VERSIONINFO
FILEVERSION VER_COMMA
PRODUCTVERSION VER_COMMA
FILEFLAGSMASK 0x3f
FILEFLAGS 0x0
FILEOS 0x40004      // VOS_NT_WINDOWS32
FILETYPE 0x1        // VFT_APP
FILESUBTYPE 0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "tattsun"
            VALUE "FileDescription", "Togglite"
            VALUE "FileVersion", VER_STR
            VALUE "InternalName", "togglite"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "togglite.exe"
            VALUE "ProductName", "Togglite"
            VALUE "ProductVersion", VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
